
# --- Base de datos ---
DATABASE_URL=postgresql://canchas_user:canchas_pass@postgres:5432/canchas_db

DATABASE_SSL=false

# --- JWT (debe ser IDÉNTICO en gateway y api-usuarios) ---
JWT_SECRET=cambiar_esta_clave_en_produccion

# --- Secreto interno (debe ser IDÉNTICO en gateway y los 4 microservicios) ---
# Autentica al gateway ante los microservicios; sin él, cualquiera podría pegarle
# directo a la URL pública de un microservicio salteándose el gateway.
INTERNAL_SECRET=cambiar_este_secreto_interno


GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Tiempo máximo (ms) que el chatbot espera a Gemini en cada paso. Default 45000.
# GEMINI_TIMEOUT_MS=45000

# --- Notificaciones por mail (api-notificaciones) ---
# SMTP gratuito. Si SMTP_HOST queda vacío el servicio arranca pero NO envía mails (solo loguea).
# Gmail (~500/día): smtp.gmail.com, puerto 587, SMTP_SECURE=false, usuario = tu cuenta y
#   contraseña = "contraseña de aplicación" (https://myaccount.google.com/apppasswords).
# Brevo (300/día): smtp-relay.brevo.com, puerto 587, con la clave SMTP de tu cuenta.
# Prueba local sin enviar nada real: SMTP_HOST=mailpit SMTP_PORT=1025 (ver docker-compose, perfil dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
FRONTEND_URL=http://localhost:5173

# --- Frontend en contenedor (docker-compose) ---
# URL del gateway que se embebe en el bundle al construir la imagen. Por defecto: http://localhost:3000.
# En el VPS, descomentar y poner la IP o dominio público (si se usa el contenedor frontend; con Vercel se
# configura en el proyecto de Vercel).
# VITE_API_URL=http://<ip-o-dominio>:3000

# --- Solo VPS: gateway detrás del proxy HTTPS compartido ---
# Suma docker-compose.vps.yml (gateway en la red "edge"). Ver docs/DEPLOY.md, "HTTPS / dominio".
# COMPOSE_FILE=docker-compose.yml:docker-compose.vps.yml
# Front + API en un solo dominio (el proxy manda /api/* al gateway). Con esto el frontend se
# reconstruye apuntando al dominio y los links de pago vuelven a él:
# VITE_API_URL=https://reservacanchas.allcloud.com.ar/api
# FRONTEND_URL=https://reservacanchas.allcloud.com.ar
